generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  senha        String
  role         Role     @default(CLIENTE)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  cliente      Cliente?

  @@map("usuarios")
}

model Cliente {
  id                  String               @id @default(cuid())
  usuarioId           String               @unique
  usuario             Usuario              @relation(fields: [usuarioId], references: [id])
  numeroDeSuite       Int                  @unique
  nomeCompleto        String
  documento           String?
  telefone            String
  pais                String
  cep                 String?
  endereco            String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  fotoPerfil          String?
  status              StatusCliente        @default(ATIVA)
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt
  itens               Item[]
  envios              Envio[]
  pedidosCompra       PedidoCompra[]
  caixas              CaixaRecebida[]
  servicos            SolicitacaoServico[]
  cobrancas           Cobranca[]
  leiturasAtualizacao LeituraAtualizacao[]

  @@index([status])
  @@map("clientes")
}

model Item {
  id           String         @id @default(cuid())
  clienteId    String
  cliente      Cliente        @relation(fields: [clienteId], references: [id])
  descricao    String
  lojaOrigem   String?
  trackingLoja String?
  fotos        String[]       @default([])
  observacoes  String?
  status       StatusItem     @default(RECEBIDO)
  dataEntrada  DateTime       @default(now())
  dataEnvio    DateTime?
  dataEntrega  DateTime?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  envios       ItemEnvio[]
  caixa        CaixaRecebida?

  @@index([clienteId, status])
  @@index([clienteId, dataEntrada(sort: Desc)])
  @@index([status, dataEntrada])
  @@index([criadoEm])
  @@map("itens")
}

model TokenRecuperacao {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@map("tokens_recuperacao")
}

model ConviteCliente {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String?
  usado     Boolean  @default(false)
  expiresAt DateTime
  criadoEm  DateTime @default(now())

  @@map("convites_cliente")
}

model Configuracao {
  id                String    @id @default(cuid())
  diasGratuitos     Int       @default(30)
  taxaDiariaArmazem Float     @default(0)
  moedaTaxa         String    @default("USD")
  precoUnboxing     Float     @default(0)
  precoFotoVideo    Float     @default(0)
  precoFoto         Float     @default(0)
  precoVideo        Float     @default(0)
  precoMedicao      Float     @default(0)
  precoReembalagem  Float     @default(0)
  precoOutro        Float     @default(0)
  nomeEmpresa       String    @default("KMundo Warehouse")
  emailContato      String?
  whatsappRecepcao  String?
  chavePix          String?
  qrCodePix         String?
  instrucoesPix     String?   @db.Text
  termosUso         String?   @db.Text
  wiseLink          String?
  koreanBankName    String?
  koreanBankAccount String?
  koreanBankHolder  String?
  blingAccessToken  String?   @db.Text
  blingRefreshToken String?   @db.Text
  blingExpiraEm     DateTime?
  blingConectadoEm  DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  @@map("configuracoes")
}

model Envio {
  id                         String        @id @default(cuid())
  clienteId                  String
  cliente                    Cliente       @relation(fields: [clienteId], references: [id])
  itens                      ItemEnvio[]
  caixas                     CaixaEnvio[]
  metodoEnvio                MetodoEnvio
  status                     StatusEnvio   @default(AGUARDANDO_CONFIRMACAO)
  peso                       Float?
  largura                    Float?
  altura                     Float?
  comprimento                Float?
  valorDeclarado             Float?
  valorDeclaradoTexto        String?       @db.Text
  moeda                      String?       @default("BRL")
  valorFrete                 Float?
  moedaFrete                 String?       @default("BRL")
  fotos                      String[]      @default([])
  videoUrl                   String?
  trackingEnvio              String?
  dataLimitePagamento        DateTime?
  observacoes                String?
  confirmadoCliente          Boolean       @default(false)
  fretePago                  Boolean       @default(false)
  declaracaoConteudo         String?       @db.Text
  // Novos campos obrigatórios reforma Envios
  enderecoCompleto           String?       @db.Text
  usarEnderecoCoreano        Boolean       @default(false)
  enderecoCoreano            String?       @db.Text
  telefoneCoreano            String?
  aceitouTermos              Boolean       @default(false)
  aceitouTermosEm            DateTime?
  comprovanteFreteUrl        String?
  comprovanteFreteEnviadoEm  DateTime?
  fotosRecebimento           String[]      @default([])
  caixaRecebidaEm            DateTime?
  caixaRecebidaConfirmadaPor String?
  criadoEm                   DateTime      @default(now())
  atualizadoEm               DateTime      @updatedAt
  cobrancas                  Cobranca[]
  eventos                    EventoEnvio[]

  @@index([clienteId, criadoEm(sort: Desc)])
  @@index([clienteId, status])
  @@map("envios")
}

model CaixaRecebida {
  id                   String               @id @default(cuid())
  clienteId            String
  cliente              Cliente              @relation(fields: [clienteId], references: [id])
  itemId               String?              @unique
  item                 Item?                @relation(fields: [itemId], references: [id])
  tracking             String
  lojaOrigem           String?
  comprovanteCompraUrl String
  fotoEtiquetaUrl      String?
  fotoEtiquetaUrls     String[]           @default([])
  observacoes          String?              @db.Text
  status               StatusCaixa          @default(PENDENTE)
  recebidoEm           DateTime?
  criadoEm             DateTime             @default(now())
  atualizadoEm         DateTime             @updatedAt
  solicitacoes         SolicitacaoServico[]
  envios               CaixaEnvio[]

  @@unique([clienteId, tracking])
  @@index([status])
  @@index([tracking])
  @@index([clienteId, criadoEm(sort: Desc)])
  @@map("caixas_recebidas")
}

model SolicitacaoServico {
  id                String         @id @default(cuid())
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id])
  caixaId           String?
  caixa             CaixaRecebida? @relation(fields: [caixaId], references: [id])
  tipo              TipoServico
  status            StatusServico  @default(SOLICITADO)
  descricao         String?        @db.Text
  observacoesEquipe String?        @db.Text
  fotoUrls          String[]       @default([])
  videoUrl          String?
  peso              Float?
  largura           Float?
  altura            Float?
  comprimento       Float?
  concluidoEm       DateTime?
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt
  cobrancas         Cobranca[]

  @@index([clienteId, criadoEm(sort: Desc)])
  @@index([caixaId])
  @@map("solicitacoes_servico")
}

model Cobranca {
  id             String              @id @default(cuid())
  clienteId      String
  cliente        Cliente             @relation(fields: [clienteId], references: [id])
  envioId        String?
  envio          Envio?              @relation(fields: [envioId], references: [id])
  solicitacaoId  String?
  solicitacao    SolicitacaoServico? @relation(fields: [solicitacaoId], references: [id])
  descricao      String
  valor          Float
  moeda          String              @default("BRL")
  status         StatusCobranca      @default(PENDENTE)
  chavePix       String?
  copiaEColaPix  String?             @db.Text
  comprovanteUrl String?
  pagoEm         DateTime?
  confirmadoEm   DateTime?
  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt
  notaFiscal     NotaFiscal?

  @@index([clienteId, criadoEm(sort: Desc)])
  @@index([status])
  @@map("cobrancas")
}

model NotaFiscal {
  id               String           @id @default(cuid())
  cobrancaId       String           @unique
  cobranca         Cobranca         @relation(fields: [cobrancaId], references: [id])
  tipo             TipoNotaFiscal
  status           StatusNotaFiscal @default(PENDENTE)
  numero           String?
  chaveAcesso      String?
  urlPdf           String?
  blingDocumentoId String?
  erro             String?          @db.Text
  emitidaEm        DateTime?
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt

  @@index([status])
  @@map("notas_fiscais")
}

model EventoEnvio {
  id        String   @id @default(cuid())
  envioId   String
  envio     Envio    @relation(fields: [envioId], references: [id], onDelete: Cascade)
  titulo    String
  descricao String?  @db.Text
  criadoEm  DateTime @default(now())

  @@index([envioId, criadoEm])
  @@map("eventos_envio")
}

model PedidoCompra {
  id                      String                @id @default(cuid())
  clienteId               String
  cliente                 Cliente               @relation(fields: [clienteId], references: [id])
  itens                   PedidoCompraItem[]
  status                  StatusPedidoCompra    @default(SOLICITADO)
  valorTotal              Float?
  moeda                   String                @default("BRL")
  chavePix                String?
  qrCodePix               String?
  instrucoesPix           String?
  linkCartao              String?
  whatsappRecepcao        String?
  observacoesCliente      String?               @db.Text
  observacoesAdmin        String?               @db.Text
  dataLimitePagamento     DateTime?
  formaPagamentoCliente   FormaPagamentoPedido?
  pagoEm                  DateTime?
  comprovanteCompraUrl    String?
  comprovantePagamentoUrl String?
  comprovanteEnviadoEm    DateTime?
  comprovanteConfirmadoEm DateTime?
  criadoEm                DateTime              @default(now())
  atualizadoEm            DateTime              @updatedAt

  @@index([clienteId, criadoEm(sort: Desc)])
  @@index([clienteId, status])
  @@map("pedidos_compra")
}

model PedidoConfig {
  id                   String   @id @default(cuid())
  titulo               String   @default("Pedidos de Compra")
  subtitulo            String?  @db.Text
  introducaoHtml       String?  @db.Text
  comoFuncionaHtml     String?  @db.Text
  passoAPassoHtml      String?  @db.Text
  podeNaoPodeHtml      String?  @db.Text
  etapasHtml           String?  @db.Text
  regrasHtml           String?  @db.Text
  posPedidoHtml        String?  @db.Text
  regrasAdicionaisHtml String?  @db.Text
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@map("pedido_config")
}

model EnvioConfig {
  id                                       String   @id @default(cuid())
  titulo                                   String   @default("Envios")
  subtitulo                                String?  @db.Text
  introducaoHtml                           String?  @db.Text
  termosUsoHtml                            String?  @db.Text
  avisoValorDeclaradoHtml                  String?  @db.Text
  avisoEnderecoHtml                        String?  @db.Text
  avisoEnderecoCoreanoHtml                 String?  @db.Text
  painelInfoHtml                           String?  @db.Text
  statusAguardandoConfirmacaoHtml          String?  @db.Text
  statusAguardandoPagamentoHtml            String?  @db.Text
  statusAguardandoConfirmacaoPagamentoHtml String?  @db.Text
  statusPagamentoFeitoHtml                 String?  @db.Text
  statusEnviadoHtml                        String?  @db.Text
  statusCaixaRecebidaHtml                  String?  @db.Text
  prazosHtml                               String?  @db.Text
  pagamentoHtml                            String?  @db.Text
  comprovanteHtml                          String?  @db.Text
  envioHtml                                String?  @db.Text
  recebimentoHtml                          String?  @db.Text
  regrasAdicionaisHtml                     String?  @db.Text
  criadoEm                                 DateTime @default(now())
  atualizadoEm                             DateTime @updatedAt

  @@map("envio_config")
}

model Atualizacao {
  id           String               @id @default(cuid())
  titulo       String
  conteudo     String               @db.Text
  publicadaEm  DateTime             @default(now())
  arquivada    Boolean              @default(false)
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  leituras     LeituraAtualizacao[]

  @@index([arquivada, publicadaEm(sort: Desc)])
  @@map("atualizacoes")
}

model LeituraAtualizacao {
  id            String      @id @default(cuid())
  atualizacaoId String
  atualizacao   Atualizacao @relation(fields: [atualizacaoId], references: [id], onDelete: Cascade)
  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  confirmadoEm  DateTime    @default(now())
  criadoEm      DateTime    @default(now())

  @@unique([atualizacaoId, clienteId])
  @@index([atualizacaoId, confirmadoEm])
  @@index([clienteId, confirmadoEm(sort: Desc)])
  @@map("leituras_atualizacao")
}

model PedidoCompraItem {
  id             String       @id @default(cuid())
  pedidoCompraId String
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  produtoShopId  String?
  produtoShop    ProdutoShop? @relation(fields: [produtoShopId], references: [id], onDelete: SetNull)
  nomeProduto    String
  urlProduto     String?
  quantidade     Int          @default(1)
  variacao       String?
  observacoes    String?      @db.Text
  fotoUrls       String[]     @default([])

  @@index([produtoShopId])
  @@map("pedidos_compra_itens")
}

model ShopCategoria {
  id           String   @id @default(cuid())
  nome         String   @unique
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, ordem])
  @@map("shop_categorias")
}

model ProdutoShop {
  id            String             @id @default(cuid())
  nome          String
  descricao     String?            @db.Text
  categoria     String?
  precoEstimado Float?
  moeda         String             @default("BRL")
  imagemUrl     String?
  urlProduto    String?
  ativo         Boolean            @default(true)
  ordem         Int                @default(0)
  criadoEm      DateTime           @default(now())
  atualizadoEm  DateTime           @updatedAt
  pedidoItens   PedidoCompraItem[]

  @@index([ativo, ordem])
  @@map("produtos_shop")
}

model Funcionario {
  id           String                  @id @default(cuid())
  nomeCompleto String
  email        String?
  telefone     String?
  cargo        String?
  dataAdmissao DateTime?
  salarioBase  Float?
  status       StatusFuncionario       @default(ATIVO)
  observacoes  String?                 @db.Text
  lancamentos  LancamentoFuncionario[]
  criadoEm     DateTime                @default(now())
  atualizadoEm DateTime                @updatedAt

  @@map("funcionarios")
}

model LancamentoFuncionario {
  id              String                    @id @default(cuid())
  funcionarioId   String
  funcionario     Funcionario               @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  tipo            TipoLancamentoFuncionario
  dataReferencia  DateTime
  valor           Float?
  horas           Float?
  quantidadeDias  Int?
  arquivoAtestado String?
  descricao       String?                   @db.Text
  criadoEm        DateTime                  @default(now())
  atualizadoEm    DateTime                  @updatedAt

  @@map("lancamentos_funcionario")
}

model FretePais {
  id           String        @id @default(cuid())
  nome         String
  codigo       String        @unique
  moeda        String        @default("BRL")
  ativo        Boolean       @default(true)
  ordem        Int           @default(0)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  tarifas      FreteTarifa[]

  @@index([ativo, ordem])
  @@map("frete_paises")
}

model FreteCaixaTipo {
  id           String        @id @default(cuid())
  nome         String
  descricao    String?       @db.Text
  comprimento  Float?
  largura      Float?
  altura       Float?
  pesoMax      Float?
  ativo        Boolean       @default(true)
  ordem        Int           @default(0)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  tarifas      FreteTarifa[]

  @@index([ativo, ordem])
  @@map("frete_caixas")
}

model FreteTarifa {
  id           String          @id @default(cuid())
  paisId       String
  pais         FretePais       @relation(fields: [paisId], references: [id], onDelete: Cascade)
  caixaTipoId  String?
  caixaTipo    FreteCaixaTipo? @relation(fields: [caixaTipoId], references: [id], onDelete: SetNull)
  pesoMin      Float
  pesoMax      Float
  valor        Float
  moeda        String          @default("BRL")
  taxaServico  Float           @default(0)
  ativo        Boolean         @default(true)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@index([paisId, caixaTipoId, ativo])
  @@index([paisId, pesoMin, pesoMax])
  @@map("frete_tarifas")
}

model FreteConfig {
  id                   String   @id @default(cuid())
  titulo               String   @default("Calculadora de Frete")
  subtitulo            String?  @db.Text
  introducaoHtml       String?  @db.Text
  comoFuncionaHtml     String?  @db.Text
  avisoEstimativaHtml  String?  @db.Text
  comoPesoHtml         String?  @db.Text
  comoPaisHtml         String?  @db.Text
  comoCaixasHtml       String?  @db.Text
  taxasServicoHtml     String?  @db.Text
  diferencasValorHtml  String?  @db.Text
  regrasAdicionaisHtml String?  @db.Text
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@map("frete_config")
}

model ItemEnvio {
  id      String @id @default(cuid())
  envioId String
  envio   Envio  @relation(fields: [envioId], references: [id])
  itemId  String
  item    Item   @relation(fields: [itemId], references: [id])

  @@index([envioId])
  @@index([itemId])
  @@map("itens_envio")
}

model CaixaEnvio {
  id      String        @id @default(cuid())
  envioId String
  envio   Envio         @relation(fields: [envioId], references: [id])
  caixaId String
  caixa   CaixaRecebida @relation(fields: [caixaId], references: [id])

  @@index([envioId])
  @@index([caixaId])
  @@map("caixas_envio")
}

enum Role {
  ADMIN
  CLIENTE
}

enum StatusCliente {
  PENDENTE
  ATIVA
  SUSPENSA
}

enum StatusItem {
  RECEBIDO
  EM_ARMAZEM
  EM_ENVIO
  PREPARANDO_ENVIO
  ENVIADO
  ENTREGUE
}

enum MetodoEnvio {
  FEDEX
  EMS
  ENVIO_EM_GRUPO
}

enum StatusEnvio {
  AGUARDANDO_CONFIRMACAO
  AGUARDANDO_PAGAMENTO
  AGUARDANDO_CONFIRMACAO_PAGAMENTO
  PAGAMENTO_FEITO
  CONFIRMADO
  EMBALANDO
  PAGO
  ENVIADO
  ENTREGUE
  CAIXA_RECEBIDA
}

enum StatusPedidoCompra {
  SOLICITADO
  EM_ANALISE
  COTACAO_DISPONIVEL
  AGUARDANDO_CONFIRMACAO_CLIENTE
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_FEITO
  COMPRADO
  CANCELADO
  AGUARDANDO_REVISAO
  AGUARDANDO_CONFIRMACAO
  PAGO
}

enum FormaPagamentoPedido {
  PIX
  CARTAO_WHATSAPP
}

enum StatusFuncionario {
  ATIVO
  INATIVO
}

enum TipoLancamentoFuncionario {
  PAGAMENTO
  HORA_EXTRA
  ATESTADO
  DESCONTO
  OBSERVACAO
}

enum TipoServico {
  UNBOXING
  FOTO_VIDEO
  FOTO
  VIDEO
  MEDICAO
  REEMBALAGEM
  OUTRO
}

enum StatusCaixa {
  PENDENTE
  RECEBIDA
}

enum StatusServico {
  SOLICITADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusCobranca {
  PENDENTE
  COMPROVANTE_ENVIADO
  PAGO
  CANCELADA
}

enum TipoNotaFiscal {
  NFE
  NFSE
}

enum StatusNotaFiscal {
  PENDENTE
  EMITIDA
  ERRO
  CANCELADA
}
